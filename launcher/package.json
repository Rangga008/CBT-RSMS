{
	"name": "cbt-rsms-launcher",
	"version": "1.0.0",
	"description": "CBT RSMS - Installer & Control Panel",
	"main": "src/main.js",
	"scripts": {
		"icons": "node scripts/create-icons.js",
		"start": "npm run icons && electron .",
		"dev": "npm run icons && electron . --dev",
		"build:win": "npm run icons && electron-builder --win --x64",
		"build:linux": "npm run icons && electron-builder --linux",
		"postinstall": "electron-builder install-app-deps"
	},
	"dependencies": {
		"node-pty": "^1.0.0"
	},
	"devDependencies": {
		"electron": "^30.0.0",
		"electron-builder": "^24.13.3"
	},
	"build": {
		"appId": "com.rsms.cbt",
		"productName": "CBT RSMS",
		"copyright": "Copyright © 2024 RSMS",
		"directories": {
			"output": "dist-electron",
			"buildResources": "assets"
		},
		"files": [
			"src/**/*",
			"assets/**/*",
			"package.json"
		],
		"asarUnpack": [
			"**/*.node"
		],
		"extraResources": [
			{
				"from": "../",
				"to": "app",
				"filter": [
					"backend/**",
					"frontend/**",
					"package.json",
					"package-lock.json",
					"ecosystem.config.cjs",
					"installer/**",
					"!**/node_modules",
					"!backend/public",
					"!**/.git"
				]
			}
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "assets/icon.ico",
			"requestedExecutionLevel": "requireAdministrator"
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"icon": "assets/icon.png",
			"category": "Education"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"installerIcon": "assets/icon.ico",
			"uninstallerIcon": "assets/icon.ico",
			"installerHeaderIcon": "assets/icon.ico",
			"createDesktopShortcut": "always",
			"createStartMenuShortcut": true,
			"shortcutName": "CBT RSMS",
			"displayLanguageSelector": false
		}
	}
}
