{
	"name": "cbt-rsms",
	"version": "1.0.0",
	"description": "Sistem Ujian Online CBT RSMS - Computer Based Test",
	"private": true,
	"scripts": {
		"dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
		"dev:backend": "npm run dev --workspace=backend",
		"dev:frontend": "npm run dev --workspace=frontend",
		"build": "npm run build --workspace=frontend && npm run build --workspace=backend",
		"start": "npm run start --workspace=backend",
		"install:all": "npm install && npm install --workspace=backend && npm install --workspace=frontend",
		"db:migrate": "npm run db:migrate --workspace=backend",
		"db:seed": "npm run db:seed --workspace=backend",
		"db:studio": "npm run db:studio --workspace=backend",
		"start:pm2": "npm run build && pm2 start ecosystem.config.cjs",
		"stop:pm2": "pm2 stop cbt-rsms-backend",
		"logs:pm2": "pm2 logs cbt-rsms-backend",
		"launcher:dev": "npm run dev --prefix launcher",
		"launcher:build:win": "npm run build:win --prefix launcher",
		"launcher:build:linux": "npm run build:linux --prefix launcher"
	},
	"workspaces": [
		"backend",
		"frontend"
	],
	"devDependencies": {
		"concurrently": "^8.2.2"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
