// This is your Prisma schema file for BK RSMS
// Sistem Absensi & Bimbingan Konseling

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USERS & SESSIONS
// ==========================================
enum UserRole {
  admin
  bk
  guru
  siswa
}

model User {
  id              String    @id @default(cuid()) @map("user_id")
  userId          String    @unique @map("user_code")
  nama            String
  password        String
  role            UserRole
  kelas           String?   // guru: "X-RPL,XI-IPS" | bk: null | admin: null
  isActive        Boolean   @default(true) @map("is_active")
  displayPassword String?   @map("display_password")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ==========================================
// SISWA
// ==========================================
model Siswa {
  id           String    @id @default(cuid()) @map("siswa_id")
  nisn         String    @unique
  nama         String
  jenisKelamin String    @map("jenis_kelamin") // L / P
  tanggalLahir DateTime? @map("tanggal_lahir") @db.Date
  agama        String?
  namaAyah     String?   @map("nama_ayah")
  namaIbu      String?   @map("nama_ibu")
  noHp         String?   @map("no_hp")
  kelas        String
  alamat       String?
  fotoUrl      String?   @map("foto_url")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  absensiList     Absensi[]
  poinList        PoinSiswa[]
  kasusList       KasusSiswa[]
  kunjunganList   KunjunganRumah[]

  @@map("siswa")
}

// ==========================================
// ABSENSI
// ==========================================
enum StatusAbsensi {
  Hadir
  Sakit
  Izin
  Alpa
}

model Absensi {
  id            String        @id @default(cuid()) @map("absensi_id")
  tanggal       DateTime      @db.Date
  siswaNisn     String        @map("siswa_nisn")
  namaSnapshot  String        @map("nama_snapshot")
  kelasSnapshot String        @map("kelas_snapshot")
  jamDatang     String?       @map("jam_datang")
  jamPulang     String?       @map("jam_pulang")
  jamSholat     String?       @map("jam_sholat")
  status        StatusAbsensi @default(Hadir)
  keterangan    String?       // "Tepat Waktu" | "Terlambat X menit" | "Pulang Cepat"
  catatan       String?       // catatan guru/admin
  inputBy       String?       @map("input_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  siswa Siswa @relation(fields: [siswaNisn], references: [nisn], onDelete: Cascade)

  @@unique([tanggal, siswaNisn])
  @@index([tanggal])
  @@index([siswaNisn])
  @@map("absensi")
}

model HariLibur {
  id         String   @id @default(cuid())
  tanggal    DateTime @unique @db.Date
  keterangan String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("hari_libur")
}

model AppConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

// ==========================================
// BK: JENIS PELANGGARAN
// ==========================================
enum KategoriPelanggaran {
  ringan
  sedang
  berat
  sangat_berat
}

model JenisPelanggaran {
  id         String               @id @default(cuid()) @map("jenis_id")
  kode       String               @unique
  nama       String
  kategori   KategoriPelanggaran  @default(ringan)
  poin       Int                  @default(5)
  deskripsi  String?
  isActive   Boolean              @default(true) @map("is_active")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  poinList  PoinSiswa[]
  kasusList KasusSiswa[]

  @@map("jenis_pelanggaran")
}

// ==========================================
// BK: JENIS PRESTASI
// ==========================================
enum KategoriPrestasi {
  akademik
  non_akademik
  olahraga
  seni
  keagamaan
  organisasi
}

model JenisPrestasi {
  id        String           @id @default(cuid()) @map("jenis_id")
  kode      String           @unique
  nama      String
  kategori  KategoriPrestasi @default(akademik)
  poin      Int              @default(10)
  deskripsi String?
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  poinList PoinSiswa[]

  @@map("jenis_prestasi")
}

// ==========================================
// BK: JENIS KASUS
// ==========================================
model JenisKasus {
  id        String   @id @default(cuid()) @map("jenis_id")
  kode      String   @unique
  nama      String
  deskripsi String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kasusList KasusSiswa[]

  @@map("jenis_kasus")
}

// ==========================================
// BK: POIN SISWA
// ==========================================
enum TipePoin {
  PRESTASI
  PELANGGARAN
}

model PoinSiswa {
  id                 String    @id @default(cuid()) @map("poin_id")
  siswaNisn          String    @map("siswa_nisn")
  tipe               TipePoin
  jenisPrestasiId    String?   @map("jenis_prestasi_id")
  jenisPelanggaranId String?   @map("jenis_pelanggaran_id")
  poin               Int
  deskripsi          String?
  tanggal            DateTime  @db.Date
  tingkat            String?   // sekolah, kabupaten, provinsi, nasional, internasional
  inputBy            String?   @map("input_by")
  dokumenUrl         String?   @map("dokumen_url")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  siswa            Siswa             @relation(fields: [siswaNisn], references: [nisn], onDelete: Cascade)
  jenisPrestasi    JenisPrestasi?    @relation(fields: [jenisPrestasiId], references: [id])
  jenisPelanggaran JenisPelanggaran? @relation(fields: [jenisPelanggaranId], references: [id])

  @@index([siswaNisn])
  @@index([tanggal])
  @@map("poin_siswa")
}

// ==========================================
// BK: KASUS SISWA
// ==========================================
enum StatusKasus {
  Baru
  Proses
  Selesai
  Ditutup
}

model KasusSiswa {
  id                 String      @id @default(cuid()) @map("kasus_id")
  nomor              String      @unique
  siswaNisn          String      @map("siswa_nisn")
  jenisKasusId       String?     @map("jenis_kasus_id")
  jenisPelanggaranId String?     @map("jenis_pelanggaran_id")
  tanggal            DateTime    @db.Date
  deskripsi          String      @db.Text
  status             StatusKasus @default(Baru)
  penanganan         String?     @db.Text
  catatan            String?     @db.Text
  inputBy            String?     @map("input_by")
  dokumenList        Json?       @map("dokumen_list") // [{nama, url, tipe}]
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  siswa            Siswa             @relation(fields: [siswaNisn], references: [nisn], onDelete: Cascade)
  jenisKasus       JenisKasus?       @relation(fields: [jenisKasusId], references: [id])
  jenisPelanggaran JenisPelanggaran? @relation(fields: [jenisPelanggaranId], references: [id])
  laporanList      LaporanKasus[]

  @@index([siswaNisn])
  @@index([status])
  @@map("kasus_siswa")
}

model LaporanKasus {
  id        String      @id @default(cuid()) @map("laporan_id")
  kasusId   String      @map("kasus_id")
  tanggal   DateTime    @db.Date
  catatan   String      @db.Text
  status    StatusKasus
  inputBy   String?     @map("input_by")
  createdAt DateTime    @default(now()) @map("created_at")

  kasus KasusSiswa @relation(fields: [kasusId], references: [id], onDelete: Cascade)

  @@map("laporan_kasus")
}

// ==========================================
// BK: KUNJUNGAN RUMAH
// ==========================================
enum StatusKunjungan {
  Rencana
  Berlangsung
  Selesai
  Dibatalkan
}

model KunjunganRumah {
  id             String          @id @default(cuid()) @map("kunjungan_id")
  nomor          String          @unique
  siswaNisn      String          @map("siswa_nisn")
  tanggal        DateTime        @db.Date
  tujuan         String          @db.Text
  petugasBk      String?         @map("petugas_bk")
  status         StatusKunjungan @default(Rencana)
  hasilKunjungan String?         @map("hasil_kunjungan") @db.Text
  catatan        String?         @db.Text
  dokumenList    Json?           @map("dokumen_list") // [{nama, tipe, url, required}]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  siswa Siswa @relation(fields: [siswaNisn], references: [nisn], onDelete: Cascade)

  @@index([siswaNisn])
  @@index([tanggal])
  @@map("kunjungan_rumah")
}

// ==========================================
// MASTER DATA
// ==========================================
model Kelas {
  id   String @id @default(cuid())
  nama String @unique
  
  @@map("kelas")
}

model Mapel {
  id   String @id @default(cuid())
  nama String @unique
  
  @@map("mapel")
}
