# ===========================================
# CBT RSMS Backend - Environment Configuration
# ===========================================
# Salin file ini ke .env dan isi nilainya
# JANGAN commit file .env ke repository!

# --- SERVER ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- DATABASE (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://cbt_user:ganti_password_kuat@localhost:5432/cbt_rsms"

# --- REDIS ---
REDIS_URL="redis://localhost:6379"
# Jika Redis pakai password:
# REDIS_URL="redis://:password@localhost:6379"

# --- JWT ---
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="ganti_dengan_secret_panjang_dan_acak_minimal_64_karakter"
JWT_REFRESH_SECRET="ganti_dengan_secret_refresh_berbeda_minimal_64_karakter"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# --- FRONTEND URL (untuk CORS) ---
# Pisahkan dengan koma jika lebih dari satu
FRONTEND_URL="http://localhost:5173"

# --- IP MANAGEMENT ---
# Mode: "open" = semua IP bisa akses, "whitelist" = hanya IP di database
IP_FILTER_MODE=open
# IP yang SELALU diizinkan (superadmin), pisahkan koma
IP_SUPERADMIN=127.0.0.1,::1

# --- FILE UPLOAD ---
MAX_FILE_SIZE_MB=5
UPLOAD_DIR="./uploads"

# --- APLIKASI ---
APP_NAME="Ujian Online V.3"
APP_SUBTITLE="Sistem Ujian Terintegrasi"
